# Blog Generator - Environment Configuration
# Copy this file to .env and fill in your credentials
# NEVER commit .env to git!

# OpenAI API Key (for DALL-E image generation)
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY="sk-proj-YOUR_OPENAI_KEY_HERE"

# WordPress Configuration
# Your WordPress site URL (must start with https://)
WORDPRESS_SITE="https://yourblog.com"

# Your WordPress username (case-sensitive)
WORDPRESS_USERNAME="your_username"

# WordPress Application Password (no spaces!)
# Get from: WordPress Dashboard → Users → Profile → Application Passwords
WORDPRESS_APP_PASSWORD="your_app_password_no_spaces"

# Blog Branding
# Your blog name (used for image watermarks)
BLOG_NAME="Your Blog Name"

# Your blog topic/niche (content will adapt to this)
BLOG_NICHE="Your Blog Topic"
